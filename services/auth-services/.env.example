# ── MySQL (also read by the mysql container via env_file) ──────────────────────
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=linkey_auth
MYSQL_USER=linkeydev
MYSQL_PASSWORD=change_this_app_password

# ── Sequelize connection (must match the vars above) ──────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=linkey_auth
DB_USER=linkeydev
DB_PASSWORD=change_this_app_password

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_secure_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_EMAIL_EXPIRY=24h
JWT_RESET_EXPIRY=1h

# ── Email (SendGrid / SMTP) ───────────────────────────────────────────────────
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=rtyailijrsiekadw
EMAIL_FROM=sharansharan1204@gmail.com
FRONTEND_URL=https://yourdomain.com

# ── WalletConnect ─────────────────────────────────────────────────────────────
WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ── Super Admin Seed (run: docker-compose exec auth-service node src/seeders/run.js) ──
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=SuperSecure1!
SEED_ADMIN_FIRST_NAME=Super
SEED_ADMIN_LAST_NAME=Admin
SEED_ADMIN_COUNTRY=US

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
SERVICE_NAME=auth-services
