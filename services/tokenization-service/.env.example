# Server
PORT=4005
NODE_ENV=development

# Database (same MySQL as other services)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=linkay_main
DB_USER=root
DB_PASS=secret
DB_LOGGING=false
DB_SYNC=false

# Redis (same Redis as other services)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT (same secret as other services)
JWT_SECRET=your_jwt_secret_here

# Pinata IPFS
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_key
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Platform
PLATFORM_URL=https://linkay.com

# File Service
FILE_SERVICE_URL=http://file-service:4007/api/v1

# Blockchain
# Set CONTRACTS_ENABLED=true only after contracts are deployed on testnet
CONTRACTS_ENABLED=false
RPC_URL=https://sepolia.infura.io/v3/your_key
DEPLOYER_PRIVATE_KEY=your_deployer_private_key
TREASURY_WALLET=0xYourTreasuryWalletAddress

# Deployed contract addresses (fill after running forge deploy)
ASSET_NFT_FACTORY_ADDRESS=
FRACTIONAL_TOKEN_FACTORY_ADDRESS=
COMPLIANCE_MODULE_ADDRESS=
