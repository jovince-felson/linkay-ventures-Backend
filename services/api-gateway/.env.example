# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── JWT (must match auth-services JWT_SECRET exactly) ────────────────────────
JWT_SECRET=change_this_to_a_secure_secret_min_32_chars

# ── Upstream services ─────────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://auth-service:3001

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=200

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
